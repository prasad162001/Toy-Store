# PostgreSQL Environment Configuration Example
# ==============================================================================
# SAFETY WARNING:
# Development database resets and destructive scripts MUST NEVER be usable
# against or executed in production environments!
# ==============================================================================

POSTGRES_DB=toy_store_dev
POSTGRES_USER=toy_admin
POSTGRES_PASSWORD=your_secure_dev_password_here
POSTGRES_PORT=5432
DATABASE_URL="postgresql://toy_admin:your_secure_dev_password_here@localhost:5432/toy_store_dev?schema=public"

JWT_SECRET=replace_with_a_long_random_dev_secret
PORT=4000
NODE_ENV=development

